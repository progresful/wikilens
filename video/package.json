{
  "name": "wikilens-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "record": "node record/takes.mjs",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts Promo",
    "render": "remotion render src/index.ts Promo out/wikilens-promo.mp4 && node scripts/loudness.mjs out/wikilens-promo.mp4",
    "stills": "node scripts/stills.mjs",
    "test": "node --test tests/camera.test.ts tests/narration.test.ts",
    "voice": "node record/voice.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
